# BashBBS: ban SSH brute force. LAN is never banned.
# Debian 12 logs sshd under ssh.service, not sshd.service.
[DEFAULT]
ignoreip = 127.0.0.1/8 192.168.1.0/24
bantime  = 1h
findtime = 10m
maxretry = 5
backend  = systemd

[sshd]
enabled = true
port    = 22
mode    = normal
journalmatch = _SYSTEMD_UNIT=ssh.service + _COMM=sshd
