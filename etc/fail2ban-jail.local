# BashBBS: ban SSH brute force. Loopback is never banned. To exempt a LAN, add its
# subnet to ignoreip on the host.
# Debian 12 logs sshd under ssh.service, not sshd.service.
# Bans go through nftables only. Debian's jail.conf defaults to iptables-multiport,
# and this [DEFAULT] section replaces those defaults. The nftables package must be installed.
[DEFAULT]
ignoreip = 127.0.0.0/8 ::1
bantime  = 1h
findtime = 10m
maxretry = 5
backend  = systemd
banaction = nftables
banaction_allports = nftables[type=allports]

[sshd]
enabled = true
port    = 22
mode    = normal
journalmatch = _SYSTEMD_UNIT=ssh.service + _COMM=sshd
