#!/bin/bash
# Sysop admin for BashBBS. The one command the sysop account may run as root
# (see etc/sudoers.d/bbs-admin). Fixed subcommands only, no shell eval, every
# name and id is checked by regex first. It calls the tools that already exist
# (bbs-approve, bbs-svara, bbs-keys, bbs-health) and writes nothing itself,
# except a moderation request in queue/incoming and a line in state/admin.log.
#
#   bbs-admin status                          one health block (bbs-health), read-only
#   bbs-admin apps list
#   bbs-admin apps accept|reject <kod> [--ja]
#   bbs-admin keys list [name]
#   bbs-admin keys add <name> <file> [--label L] [--legacy] [--ja]
#   bbs-admin keys remove <name> <fingerprint> [--force] [--ja]
#   bbs-admin keys restore <name> <historyfile> [--ja]
#   bbs-admin mod list [n]                    last n lines of state/mod.log
#   bbs-admin mod delete <board> <msgid> [--ja]
#   bbs-admin users list
#   bbs-admin users disable|enable <name> [--ja]
#   bbs-admin users remove <name> [--ja]
#
# Without --ja every change only prints what it would do and exits 0.
# Nothing is deleted: a removed home dir and key file are moved to
# _karantan-users-<stamp>/ under the BBS root. users/<name> stays, so a
# removed name is not handed out again.
#
# The sysop is the account sudo ran for ($SUDO_USER). It must be listed in
# sysops. Requests are written as the sysop's own bbs-<name> account, so the
# publisher applies the same rules as for a request from the menu.
#
# Test mode (BASHBBS_TEST set): BBS_ROOT moves the tree (/srv/bashbbs is refused),
# root is not required, and BBS_SBIN, BBS_ADMIN_USER, BBS_GETENT, BBS_USERMOD,
# BBS_USERDEL, BBS_PKILL and BBS_CHOWN replace the system tools. Outside test
# mode none of these are read.
set -uo pipefail
umask 077
export LC_ALL=C.UTF-8

UUID_RE='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
BOARD_RE='^[a-z0-9][a-z0-9_-]{1,23}$'
NAME_RE='^[a-z][a-z0-9]{2,8}$'
KOD_RE='^[0-9a-f]{4,36}$'
FP_RE='^[A-Za-z0-9+/:=._-]{8,100}$'
LABEL_RE='^[A-Za-z0-9 ._-]{1,20}$'
NOLOGIN=/usr/sbin/nologin
BBS_SHELL=/usr/local/sbin/bbs-shell

die() { echo "bbs-admin: $*" >&2; exit 1; }
usage() {
    cat >&2 <<'EOF'
usage: bbs-admin status
       bbs-admin apps list | accept|reject <kod> [--ja]
       bbs-admin keys list [name] | add <name> <file> [--label L] [--legacy] [--ja]
                   | remove <name> <fingerprint> [--force] [--ja] | restore <name> <historyfile> [--ja]
       bbs-admin mod list [n] | delete <board> <msgid> [--ja]
       bbs-admin users list | disable|enable <name> [--ja] | remove <name> [--ja]
EOF
    exit 64
}

# Parse flags anywhere on the line; everything else is positional.
ja=0; force=0; legacy=0; label=""
args=()
while (( $# )); do
    case $1 in
        --ja) ja=1 ;;
        --force) force=1 ;;
        --legacy) legacy=1 ;;
        --label) (( $# >= 2 )) || usage; label=$2; shift ;;
        --*) die "unknown option $1" ;;
        *) args+=("$1") ;;
    esac
    shift
done
cmd=${args[0]:-}
sub=${args[1]:-}

if [[ -n ${BASHBBS_TEST:-} ]]; then
    BBS_ROOT=${BBS_ROOT:-/srv/bashbbs}
    case $(readlink -m -- "$BBS_ROOT") in
        /srv/bashbbs|/srv/bashbbs/*) die "test mode refuses /srv/bashbbs" ;;
    esac
    SBIN=${BBS_SBIN:-/usr/local/sbin}
    WHO=${BBS_ADMIN_USER:-}
    GETENT=${BBS_GETENT:-/usr/bin/getent}
    USERMOD=${BBS_USERMOD:-/usr/sbin/usermod}
    USERDEL=${BBS_USERDEL:-/usr/sbin/userdel}
    PKILL=${BBS_PKILL:-/usr/bin/pkill}
    CHOWN=${BBS_CHOWN:-/usr/bin/chown}
else
    BBS_ROOT=/srv/bashbbs
    SBIN=/usr/local/sbin
    [[ $EUID -eq 0 ]] || die "must run as root (through sudo)"
    WHO=${SUDO_USER:-}
    GETENT=/usr/bin/getent
    USERMOD=/usr/sbin/usermod
    USERDEL=/usr/sbin/userdel
    PKILL=/usr/bin/pkill
    CHOWN=/usr/bin/chown
fi

[[ $WHO =~ ^[a-z][a-z0-9]{0,30}$ ]] && grep -qx -- "$WHO" "$BBS_ROOT/sysops" \
    || die "'$WHO' is not a sysop (run through sudo as the sysop account)"

(( force )) && [[ "$cmd $sub" != "keys remove" ]] && die "--force is only for keys remove"
{ (( legacy )) || [[ -n $label ]]; } && [[ "$cmd $sub" != "keys add" ]] \
    && die "--legacy and --label are only for keys add"

log_admin() { # log_admin <text>: one line per change, no key bodies
    local f=$BBS_ROOT/state/admin.log
    [[ -e $f ]] || install -m 0600 /dev/null "$f" || die "cannot open admin log"
    printf '%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$WHO" "$*" >> "$f" || die "cannot write admin log"
}

need_ja() { # need_ja <what>: without --ja, say what would happen and stop
    (( ja )) && return 0
    echo "dry run, nothing changed: $1"
    echo "add --ja to do it"
    exit 0
}

valid_name() { [[ $1 =~ $NAME_RE && $1 != news ]] || die "bad account name '$1'"; }

account_exists() { "$GETENT" passwd "bbs-$1" >/dev/null 2>&1 || die "no account bbs-$1"; }

refuse_self() { [[ $1 != "$WHO" ]] || die "refusing to change your own account"; }

hdr() { # hdr <file> <Name>: header value, headers end at the first empty line
    sed '/^$/q' "$1" | sed -n "s/^$2: *//p" | head -n 1
}

find_post() { # find_post <board> <msgid>: the one live post file, or die
    local hits=("$BBS_ROOT/boards/$1"/*-"$2".msg)
    (( ${#hits[@]} == 1 )) && [[ -f ${hits[0]} && ! -L ${hits[0]} ]] \
        || die "no single post $2 on $1"
    printf '%s\n' "${hits[0]}"
}

queue_delete() { # queue_delete <board> <msgid>: request owned by the sysop's account
    local q=$BBS_ROOT/queue tmp
    tmp=$(mktemp "$q/.admin.XXXXXX") || die "cannot create request"
    printf 'Action: delete-post\nBoard: %s\nMsgid: %s\n\n' "$1" "$2" > "$tmp" \
        || { rm -f -- "$tmp"; die "cannot write request"; }
    "$CHOWN" "bbs-$WHO" "$tmp" || { rm -f -- "$tmp"; die "cannot hand request to bbs-$WHO"; }
    mv -f -- "$tmp" "$q/incoming/$(date +%s)-$(cat /proc/sys/kernel/random/uuid).req" \
        || die "cannot queue request"
}

case $cmd in
    status)
        exec "$SBIN/bbs-health"
        ;;

    apps)
        case $sub in
            list) exec "$SBIN/bbs-approve" list ;;
            accept|reject)
                kod=${args[2]:-}
                [[ $kod =~ $KOD_RE ]] || die "bad id"
                need_ja "$sub application $kod"
                log_admin "apps $sub $kod"
                exec "$SBIN/bbs-svara" "$sub" "$kod"
                ;;
            *) usage ;;
        esac
        ;;

    keys)
        case $sub in
            list)
                if [[ -n ${args[2]:-} ]]; then valid_name "${args[2]}"; fi
                exec "$SBIN/bbs-keys" list "${args[@]:2}"
                ;;
            add)
                name=${args[2]:-}; file=${args[3]:-}
                valid_name "$name"
                [[ -f $file && ! -L $file ]] || die "not a regular file: $file"
                [[ -z $label || $label =~ $LABEL_RE ]] || die "bad label"
                need_ja "add the key in $file to bbs-$name"
                log_admin "keys add $name"
                run=("$SBIN/bbs-keys" add "$name" "$file")
                [[ -n $label ]] && run+=(--label "$label")
                (( legacy )) && run+=(--legacy)
                exec "${run[@]}"
                ;;
            remove)
                name=${args[2]:-}; fp=${args[3]:-}
                valid_name "$name"
                [[ $fp =~ $FP_RE ]] || die "bad fingerprint"
                need_ja "remove key $fp from bbs-$name"
                log_admin "keys remove $name $fp"
                run=("$SBIN/bbs-keys" remove "$name" "$fp")
                (( force )) && run+=(--force)
                exec "${run[@]}"
                ;;
            restore)
                name=${args[2]:-}; hist=${args[3]:-}
                valid_name "$name"
                [[ -f $hist && ! -L $hist ]] || die "not a regular file: $hist"
                need_ja "restore keys of bbs-$name from $hist"
                log_admin "keys restore $name"
                exec "$SBIN/bbs-keys" restore "$name" "$hist"
                ;;
            *) usage ;;
        esac
        ;;

    mod)
        case $sub in
            list)
                n=${args[2]:-20}
                [[ $n =~ ^[0-9]{1,3}$ ]] && (( n >= 1 && n <= 200 )) || die "n must be 1-200"
                if [[ -f $BBS_ROOT/state/mod.log ]]; then
                    tail -n "$n" "$BBS_ROOT/state/mod.log"
                else
                    echo "no moderation yet"
                fi
                ;;
            delete)
                board=${args[2]:-}; msgid=${args[3]:-}
                [[ $board =~ $BOARD_RE ]] || die "bad board"
                [[ $msgid =~ $UUID_RE ]] || die "bad msgid"
                post=$(find_post "$board" "$msgid")
                sed '/^$/q' "$post" | grep -q '^Deleted: ' && die "already deleted: $msgid"
                echo "post: $board $msgid by $(hdr "$post" Author): $(hdr "$post" Subject)"
                need_ja "delete $msgid on $board (the publisher does it within a minute)"
                log_admin "mod delete $board $msgid"
                queue_delete "$board" "$msgid"
                echo "queued as bbs-$WHO; check with: bbs-admin mod list"
                ;;
            *) usage ;;
        esac
        ;;

    users)
        case $sub in
            list)
                "$GETENT" passwd | awk -F: '$1 ~ /^bbs-/ {
                    print substr($1, 5) "\t" ($7 == "'"$NOLOGIN"'" ? "disabled" : "active") }'
                ;;
            disable|enable)
                name=${args[2]:-}
                valid_name "$name"
                refuse_self "$name"
                account_exists "$name"
                if [[ $sub == disable ]]; then shell=$NOLOGIN; else shell=$BBS_SHELL; fi
                need_ja "$sub bbs-$name (login shell $shell)"
                log_admin "users $sub $name"
                "$USERMOD" -s "$shell" "bbs-$name" || die "usermod failed"
                "$SBIN/bbs-alias" shell "$name" "$shell" || die "alias usermod failed"
                if [[ $sub == disable ]]; then
                    # Sessions that are already open end now, not at their next login.
                    "$PKILL" -TERM -u "bbs-$name" || true
                fi
                echo "bbs-$name: $sub done"
                ;;
            remove)
                name=${args[2]:-}
                valid_name "$name"
                refuse_self "$name"
                account_exists "$name"
                home=$("$GETENT" passwd "bbs-$name" | cut -d: -f6)
                [[ $home == "$BBS_ROOT/home/"* ]] || die "home of bbs-$name is outside $BBS_ROOT/home"
                need_ja "remove bbs-$name: disable, userdel (home and key moved to quarantine)"
                log_admin "users remove $name"
                "$USERMOD" -s "$NOLOGIN" "bbs-$name" || die "usermod failed"
                "$SBIN/bbs-alias" shell "$name" "$NOLOGIN" || die "alias usermod failed"
                "$PKILL" -TERM -u "bbs-$name" || true
                # The short-name alias goes first. It shares the home, so never userdel -r.
                "$SBIN/bbs-alias" remove "$name" || die "alias removal failed"
                "$USERDEL" "bbs-$name" || die "userdel failed (sessions still open?)"
                kar=$BBS_ROOT/_karantan-users-$(date -u +%Y%m%dT%H%M%SZ)/$name
                install -d -m 0700 "$kar" || die "cannot create quarantine"
                [[ -d $home ]] && mv -- "$home" "$kar/home"
                [[ -f $BBS_ROOT/keys/bbs-$name ]] && mv -- "$BBS_ROOT/keys/bbs-$name" "$kar/keys"
                echo "bbs-$name removed; quarantine: $kar"
                ;;
            *) usage ;;
        esac
        ;;

    *) usage ;;
esac
