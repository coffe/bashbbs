#!/bin/bash
# Root-run publisher. Handles two kinds of file in the queue:
#   *.post  a message for a board
#   *.req   a board request: create-board, invite, remove
# The author comes from the file owner, never from the file text.
# No errexit: a rejected file is logged and skipped, and the loop goes on.
set -uo pipefail
umask 022

BBS_ROOT=/srv/bashbbs
INCOMING=$BBS_ROOT/queue/incoming
META=$BBS_ROOT/meta
SYSOPS=$BBS_ROOT/sysops
MAX_BYTES=16384
MAX_OWNED=2

host=$(cat /etc/hostname)

# First "Key: value" header of a queue file.
field() { sed -n "s/^$2: //p" "$1" | head -n 1; }

# True if the account is in the group right now, read from /etc/group.
in_group() { [[ " $(id -nG "$1" 2>/dev/null) " == *" $2 "* ]]; }

is_sysop() { # is_sysop <name without prefix>
    local s
    [[ -f $SYSOPS ]] || return 1
    while read -r s || [[ -n $s ]]; do
        [[ $s == "$1" ]] && return 0
    done < "$SYSOPS"
    return 1
}

# A private board is one with a meta file. Public boards have none.
is_private() { [[ -f $META/$1.meta ]]; }

meta_owner() { sed -n 's/^owner=//p' "$META/$1.meta" 2>/dev/null | head -n 1; }

can_manage() { # can_manage <name> <board>
    [[ $(meta_owner "$2") == "$1" ]] || is_sysop "$1"
}

owned_count() { # owned_count <name>
    local m n=0
    for m in "$META"/*.meta; do
        [[ -f $m ]] || continue
        [[ $(sed -n 's/^owner=//p' "$m") == "$1" ]] && n=$((n + 1))
    done
    echo "$n"
}

# Sysops are members of every private board, so they can always read and post.
add_sysops() { # add_sysops <board>
    local s
    [[ -f $SYSOPS ]] || return 0
    while read -r s || [[ -n $s ]]; do
        id "bbs-$s" >/dev/null 2>&1 || continue
        in_group "bbs-$s" "bbsb-$1" && continue
        gpasswd -a "bbs-$s" "bbsb-$1" >/dev/null || true
    done < "$SYSOPS"
}

reconcile_sysops() {
    local m board
    for m in "$META"/*.meta; do
        [[ -f $m ]] || continue
        board=$(basename "$m" .meta)
        [[ $board =~ ^[a-z0-9][a-z0-9_-]{1,23}$ ]] || continue
        add_sysops "$board"
    done
}

create_board() { # create_board <board> <owner name>
    local board=$1 owner=$2
    groupadd "bbsb-$board" || return 1
    printf 'owner=%s\ncreated=%s\n' "$owner" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$META/$board.meta" || return 1
    install -d -m 0750 -o root -g "bbsb-$board" "$BBS_ROOT/boards/$board" || return 1
    gpasswd -a "bbs-$owner" "bbsb-$board" >/dev/null || return 1
    add_sysops "$board"
}

handle_post() { # handle_post <file> <owner account>
    local f=$1 owner=$2 board subject parent msgid stamp out tmp
    board=$(field "$f" Board)
    subject=$(field "$f" Subject | LC_ALL=C.UTF-8 sed 's/[[:cntrl:]]//g' | head -c 100)
    parent=$(field "$f" Parent)

    # Board names come from a fixed pattern and an existing directory, never as a raw path.
    [[ $board =~ ^[a-z0-9_-]{1,32}$ && -d $BBS_ROOT/boards/$board && ! -L $BBS_ROOT/boards/$board ]] || return 1
    [[ -n $subject ]] || return 1
    [[ -z $parent || $parent =~ ^[0-9a-f-]{36}$ ]] || return 1
    # A private board takes posts only from its members.
    if is_private "$board"; then
        in_group "$owner" "bbsb-$board" || return 1
    fi
    # A read-only board (the news board) takes posts only from the news account.
    if [[ -f $META/$board.readonly && $owner != bbs-news ]]; then return 1; fi

    msgid=$(cat /proc/sys/kernel/random/uuid)
    stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    out=$BBS_ROOT/boards/$board/$(date +%s)-$msgid.msg
    tmp=$BBS_ROOT/boards/$board/.tmp.$msgid

    # Body is everything after the first blank line.
    {
        printf 'Msgid: %s\n' "$msgid"
        printf 'Author: %s\n' "${owner#bbs-}"
        printf 'Node: %s\n' "$host"
        printf 'Date: %s\n' "$stamp"
        printf 'Subject: %s\n' "$subject"
        [[ -n $parent ]] && printf 'Parent: %s\n' "$parent"
        printf '\n'
        awk 'found { print } /^$/ && !found { found = 1 }' "$f" | LC_ALL=C.UTF-8 sed 's/[[:cntrl:]]//g'
    } > "$tmp" || return 1
    if is_private "$board"; then
        chgrp "bbsb-$board" "$tmp" && chmod 0640 "$tmp" || return 1
    else
        chmod 0644 "$tmp" || return 1
    fi
    mv -f "$tmp" "$out" || return 1
}

handle_req() { # handle_req <file> <owner account>
    local f=$1 owner=$2 me action board user
    me=${owner#bbs-}
    action=$(field "$f" Action)
    board=$(field "$f" Board)
    user=$(field "$f" User)

    [[ $board =~ ^[a-z0-9][a-z0-9_-]{1,23}$ ]] || return 1
    case $action in
        create-board)
            [[ ! -e $BBS_ROOT/boards/$board && ! -e $META/$board.meta ]] || return 1
            getent group "bbsb-$board" >/dev/null && return 1
            (( $(owned_count "$me") < MAX_OWNED )) || return 1
            create_board "$board" "$me"
            ;;
        invite|remove)
            is_private "$board" || return 1
            can_manage "$me" "$board" || return 1
            [[ $user =~ ^[a-z][a-z0-9]{2,15}$ ]] || return 1
            id "bbs-$user" >/dev/null 2>&1 || return 1
            if [[ $action == invite ]]; then
                gpasswd -a "bbs-$user" "bbsb-$board" >/dev/null || return 1
            else
                # The owner cannot be removed from their own board.
                [[ $user != "$(meta_owner "$board")" ]] || return 1
                gpasswd -d "bbs-$user" "bbsb-$board" >/dev/null || return 1
                # Groups are read at login, so end the removed user's sessions now.
                pkill -TERM -u "bbs-$user" 2>/dev/null || true
            fi
            ;;
        *) return 1 ;;
    esac
}

process() { # process <file>
    local f=$1 owner
    [[ -f $f && ! -L $f ]] || return 0
    owner=$(stat -c %U "$f")
    [[ $owner =~ ^bbs-[a-z][a-z0-9]{2,15}$ ]] || { rm -f "$f"; return 0; }
    [[ $(stat -c %s "$f") -le $MAX_BYTES ]] || { rm -f "$f"; return 0; }

    case $f in
        *.post) handle_post "$f" "$owner" || echo "rejected post: $f" >&2 ;;
        *.req)  handle_req "$f" "$owner" || echo "rejected request: $f" >&2 ;;
    esac
    rm -f "$f"
}

reconcile_sysops
for f in "$INCOMING"/*.post "$INCOMING"/*.req; do
    process "$f"
done
