#!/bin/bash
# Root-run publisher. Handles two kinds of file in the queue:
#   *.post  a message for a board
#   *.req   a board request: create-board, invite, remove
# The author comes from the file owner, never from the file text.
# No errexit: a rejected file is logged and skipped, and the loop goes on.
#
# News section posts (board news, marker meta/news.sections present) go through
# handle_news_post: strict header checks, a per-article ledger and a duplicate
# check under flock. process() returns 0 = done (queue file removed),
# 1 = permanently rejected (moved to drop/rejected), 2 = temporary failure
# (queue file stays and is retried; after STALE_SECS it is rejected as stale).
#
# The news index state/news-index.tsv (read by the reader, see lib/news.sh) is
# kept up to date here, one row per published article, newest first. Order of a
# publication, all under state/news.lock:
#   a) duplicate check (ledger or index)  -> done, nothing written
#   b) set the marker state/news-index.dirty
#   c) mv the article into boards/news/<cat>/
#   d) write the new index (temp file + mv)
#   e) ledger row "published"
#   f) remove the marker
# A crash after c and before f leaves the marker. At the start of every run
# (and at the end, if a marker is left) bbs-news-index repair rebuilds the index
# from the article files, which also removes the marker.
#
# Test hooks: BBS_ROOT moves the whole tree; BBS_TEST_OWNER names the account
# that owns test queue files (treated as bbs-news); BBS_LOCK_WAIT sets the
# flock timeout in seconds.
set -uo pipefail
umask 022
export LC_ALL=C.UTF-8

BBS_ROOT=${BBS_ROOT:-/srv/bashbbs}
INCOMING=$BBS_ROOT/queue/incoming
META=$BBS_ROOT/meta
SYSOPS=$BBS_ROOT/sysops
MAX_BYTES=16384
MAX_OWNED=2
MAX_BODY=11000
STALE_SECS=86400
LOCK_WAIT=${BBS_LOCK_WAIT:-20}
STATE=$BBS_ROOT/state
LEDGER=$STATE/news-ids.tsv
INDEX=$STATE/news-index.tsv
DIRTY=$STATE/news-index.dirty
CATEGORIES_FILE=$BBS_ROOT/lib/news-categories.conf
REJECTED=$BBS_ROOT/drop/rejected
HISTORY=$STATE/history          # previous versions of edited posts, root only
ADMIN_BACKUP=$STATE/admin-backup  # copies of deleted posts, root only, 30 days
MOD_LOG=$STATE/mod.log          # sysop deletions of other people's posts
ID_RE='^(legacy-[0-9a-f-]{36}|[0-9a-f]{64})$'
UUID_RE='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
WALL=$BBS_ROOT/wall              # one-line greetings, world readable, newest 100 kept
WALL_KEEP=100
WALL_MAX_BYTES=1024
WALL_MAX_CHARS=140
WALL_LOCK=$STATE/wall.lock

host=$(cat /etc/hostname)

# First "Key: value" header of a queue file.
field() { sed -n "s/^$2: //p" "$1" | head -n 1; }

# True if the account is in the group right now, read from /etc/group.
in_group() { [[ " $(id -nG "$1" 2>/dev/null) " == *" $2 "* ]]; }

is_sysop() { # is_sysop <name without prefix>
    local s
    [[ -f $SYSOPS ]] || return 1
    while read -r s || [[ -n $s ]]; do
        [[ $s == "$1" ]] && return 0
    done < "$SYSOPS"
    return 1
}

# A private board is one with a meta file. Public boards have none.
is_private() { [[ -f $META/$1.meta ]]; }

meta_owner() { sed -n 's/^owner=//p' "$META/$1.meta" 2>/dev/null | head -n 1; }

can_manage() { # can_manage <name> <board>
    [[ $(meta_owner "$2") == "$1" ]] || is_sysop "$1"
}

owned_count() { # owned_count <name>
    local m n=0
    for m in "$META"/*.meta; do
        [[ -f $m ]] || continue
        [[ $(sed -n 's/^owner=//p' "$m") == "$1" ]] && n=$((n + 1))
    done
    echo "$n"
}

# Sysops are members of every private board, so they can always read and post.
add_sysops() { # add_sysops <board>
    local s
    [[ -f $SYSOPS ]] || return 0
    while read -r s || [[ -n $s ]]; do
        id "bbs-$s" >/dev/null 2>&1 || continue
        in_group "bbs-$s" "bbsb-$1" && continue
        gpasswd -a "bbs-$s" "bbsb-$1" >/dev/null || true
    done < "$SYSOPS"
}

reconcile_sysops() {
    local m board
    for m in "$META"/*.meta; do
        [[ -f $m ]] || continue
        board=$(basename "$m" .meta)
        [[ $board =~ ^[a-z0-9][a-z0-9_-]{1,23}$ ]] || continue
        add_sysops "$board"
    done
}

create_board() { # create_board <board> <owner name>
    local board=$1 owner=$2
    groupadd "bbsb-$board" || return 1
    printf 'owner=%s\ncreated=%s\n' "$owner" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$META/$board.meta" || return 1
    install -d -m 0750 -o root -g "bbsb-$board" "$BBS_ROOT/boards/$board" || return 1
    gpasswd -a "bbs-$owner" "bbsb-$board" >/dev/null || return 1
    add_sysops "$board"
}

# ---- News sections ---------------------------------------------------------

LAST_REASON=""   # why the last news post was rejected, for the log

news_sections_on() { [[ -f $META/news.sections ]]; }

# True if the name is listed in the category allowlist (exact line match).
category_ok() { # category_ok <name>
    local c
    [[ $1 =~ ^[a-z][a-z0-9-]{0,31}$ ]] || return 1
    [[ -f $CATEGORIES_FILE ]] || return 1
    while read -r c || [[ -n $c ]]; do
        [[ -z $c || $c == \#* ]] && continue
        [[ $c == "$1" ]] && return 0
    done < "$CATEGORIES_FILE"
    return 1
}

# Value of a header in a header-only file. Callers have already checked that
# each header occurs at most once.
hfield() { sed -n "s/^$2: *//p" "$1" | head -n 1; }

# Append one ledger row. Caller holds the lock. Returns 1 on write failure.
ledger_add() { # ledger_add <id> <status> <epoch> <reason>
    printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" >> "$LEDGER" || return 1
}

ledger_has_published() { # ledger_has_published <id>
    [[ -f $LEDGER ]] || return 1
    awk -F'\t' -v id="$1" '$1 == id && $2 == "published" { f = 1; exit } END { exit !f }' "$LEDGER"
}

# True if some article file already carries this Article-Id header.
article_on_disk() { # article_on_disk <id>
    local d
    for d in "$BBS_ROOT"/boards/news/*/; do
        [[ -d $d && ! -L ${d%/} ]] || continue
        compgen -G "${d}*.msg" >/dev/null || continue
        grep -Fxl -e "Article-Id: $1" -- "$d"*.msg >/dev/null 2>&1 && return 0
    done
    return 1
}

# Index row of an article, same fields as news_index in lib/news.sh:
#   id cat epoch title path date source lede
# epoch is the sort key: Published when it is not in the future, else the file
# name's epoch. Control characters (tab too) are stripped from every field.
index_row() { # index_row <id> <cat> <file epoch> <title> <path> <stamp> <published> <source> <lede>
    local e d t s l
    e=$(date -u -d "$7" +%s 2>/dev/null) || e=$3
    if (( e <= $3 )); then d=${7:0:10}; else e=$3; d=${6:0:10}; fi
    t=$(printf %s "$4" | LC_ALL=C tr -d '\001-\037\177')
    s=$(printf %s "$8" | LC_ALL=C tr -d '\001-\037\177')
    l=$(printf %s "$9" | LC_ALL=C tr -d '\001-\037\177')
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$e" "$t" "$5" "$d" "$s" "$l"
}

index_has() { # index_has <id>
    [[ -f $INDEX ]] || return 1
    awk -F'\t' -v id="$1" '$1 == id { f = 1; exit } END { exit !f }' "$INDEX"
}

# True if any article file exists besides $1.
other_articles() {
    [[ -n $(find "$BBS_ROOT/boards/news" -mindepth 2 -maxdepth 2 -type f -name '*.msg' \
        ! -path "$1" -print -quit 2>/dev/null) ]]
}

# Put one row first into the index (stable sort, newest epoch first), via temp
# file and mv. Caller holds the lock. If there is no index but other articles
# exist, a one-row index would hide them: leave it to the repair at the end of
# the run (KEEP_MARKER=1).
KEEP_MARKER=0
index_add() { # index_add <row> <article path>
    local tmp=$STATE/news-index.tmp.$$
    if [[ ! -f $INDEX ]] && other_articles "$2"; then
        KEEP_MARKER=1; return 0
    fi
    { printf '%s\n' "$1"; if [[ -f $INDEX ]]; then cat -- "$INDEX"; fi; } \
        | LC_ALL=C sort -t $'\t' -s -k3,3nr > "$tmp" \
        && chmod 0644 "$tmp" && mv -f -- "$tmp" "$INDEX" || { rm -f -- "$tmp"; return 1; }
}

# Take the ledger lock on fd 9. Returns 2 (temporary) on timeout.
lock_take() {
    exec 9>>"$STATE/news.lock" || return 2
    flock -w "$LOCK_WAIT" 9 || { exec 9>&-; return 2; }
}
lock_drop() { exec 9>&-; }

# The wall has its own lock on fd 8, so greetings never wait for News.
wall_lock_take() {
    exec 8>>"$WALL_LOCK" || return 2
    flock -w "$LOCK_WAIT" 8 || { exec 8>&-; return 2; }
}
wall_lock_drop() { exec 8>&-; }

# Record a permanent rejection: ledger row when the id is usable, then log.
news_reject() { # news_reject <id or empty> <reason>
    LAST_REASON=$2
    if [[ $1 =~ $ID_RE ]]; then
        if lock_take; then
            ledger_has_published "$1" || ledger_add "$1" rejected "$(date +%s)" "$2" || true
            lock_drop
        else
            # Could not lock: keep the file and retry rather than lose the ledger row.
            return 2
        fi
    fi
    return 1
}

# handle_news_post <snapshot of the queue file> <headers file>
# Returns 0 published or duplicate, 1 permanent reject (LAST_REASON), 2 temporary.
handle_news_post() {
    local f=$1 hdr=$2 id cat subject source published link lede lang
    local msgid epoch stamp out tmp dir bodytmp size bytes rc

    id=$(hfield "$hdr" Article-Id)
    [[ $id =~ $ID_RE ]] || id=""

    size=$(stat -c %s "$f")
    (( size <= MAX_BYTES )) || { news_reject "$id" too-large; return; }

    # Header block: one "Name: value" per line, each name at most once, no
    # control characters (CR, ESC, NUL ...) anywhere in it.
    if LC_ALL=C grep -aqvE '^[A-Za-z][A-Za-z0-9-]*:( .*)?$' "$hdr"; then
        news_reject "$id" bad-headers; return
    fi
    if [[ -n $(sed 's/:.*//' "$hdr" | sort | uniq -d) ]]; then
        news_reject "$id" bad-headers; return
    fi
    if ! LC_ALL=C tr -d '\000-\010\013-\037\177' < "$hdr" | cmp -s - "$hdr"; then
        news_reject "$id" bad-headers; return
    fi

    cat=$(hfield "$hdr" Category)
    subject=$(hfield "$hdr" Subject | head -c 100 | iconv -c -f UTF-8 -t UTF-8)
    source=$(hfield "$hdr" Source)
    published=$(hfield "$hdr" Published)
    link=$(hfield "$hdr" Link)
    lede=$(hfield "$hdr" Lede)
    lang=$(hfield "$hdr" Original-Language)

    category_ok "$cat" || { news_reject "$id" bad-category; return; }
    [[ -n $id ]] || { news_reject "" bad-id; return; }
    if [[ -n $link ]]; then
        [[ $link =~ ^https?://[^[:space:]]+$ && $(printf %s "$link" | wc -c) -le 300 ]] \
            || { news_reject "$id" bad-link; return; }
    fi
    [[ -n $subject && -n $source && ${#source} -le 60 && ${#lede} -le 200 ]] \
        || { news_reject "$id" bad-headers; return; }
    [[ $published =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ \
        && $(date -u -d "$published" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null) == "$published" ]] \
        || { news_reject "$id" bad-headers; return; }
    [[ -z $lang || $lang =~ ^[a-z]{2,3}$ ]] || { news_reject "$id" bad-headers; return; }

    # Body is everything after the first blank line.
    bodytmp=$(mktemp "$STATE/tmp/body.XXXXXX") || return 2
    sed '1,/^$/d' "$f" > "$bodytmp"
    bytes=$(stat -c %s "$bodytmp")
    if (( bytes > MAX_BODY )); then
        rm -f "$bodytmp"
        news_reject "$id" too-large; return
    fi

    dir=$BBS_ROOT/boards/news/$cat
    # cat and id are safe path parts here: allowlist and regex checked above.
    if [[ -L $dir || -e $dir && ! -d $dir ]]; then
        rm -f "$bodytmp"
        news_reject "$id" bad-board; return
    fi

    lock_take || { rm -f "$bodytmp"; return 2; }
    epoch=$(date +%s)
    if ledger_has_published "$id"; then
        # Already published: nothing to write.
        rm -f "$bodytmp"; lock_drop; return 0
    fi
    if index_has "$id" || article_on_disk "$id"; then
        # On disk or in the index but no ledger row (crash after the move):
        # record it, so bbs-news-status answers published and no resend follows.
        rm -f "$bodytmp"
        ledger_add "$id" published "$epoch" duplicate; rc=$?
        lock_drop
        (( rc == 0 )) && return 0 || return 2
    fi

    msgid=$(cat /proc/sys/kernel/random/uuid)
    stamp=$(date -u -d "@$epoch" +%Y-%m-%dT%H:%M:%SZ)
    out=$dir/$epoch-$msgid.msg
    tmp=$(mktemp "$STATE/tmp/news.XXXXXX") || { rm -f "$bodytmp"; lock_drop; return 2; }
    {
        printf 'Board: news\n'
        printf 'Subject: %s\n' "$subject"
        printf 'Msgid: %s\n' "$msgid"
        printf 'Author: news\n'
        printf 'Node: %s\n' "$host"
        printf 'Date: %s\n' "$stamp"
        printf 'Category: %s\n' "$cat"
        printf 'Article-Id: %s\n' "$id"
        printf 'Source: %s\n' "$source"
        printf 'Published: %s\n' "$published"
        [[ -n $link ]] && printf 'Link: %s\n' "$link"
        [[ -n $lede ]] && printf 'Lede: %s\n' "$lede"
        [[ -n $lang ]] && printf 'Original-Language: %s\n' "$lang"
        printf '\n'
        LC_ALL=C.UTF-8 sed 's/[[:cntrl:]]//g' "$bodytmp"
    } > "$tmp" && chmod 0644 "$tmp" && mkdir -p -m 0755 "$dir" \
        && : > "$DIRTY" \
        && mv -f "$tmp" "$out" \
        && index_add "$(index_row "$id" "$cat" "$epoch" "$subject" "$out" "$stamp" "$published" "$source" "$lede")" "$out" \
        && ledger_add "$id" published "$epoch" ""
    rc=$?
    rm -f "$bodytmp" "$tmp"
    if (( rc != 0 )); then
        # Do not leave a file without a ledger row behind a failed write. The
        # marker stays, so the repair rebuilds the index without the file.
        rm -f "$out"
    elif (( KEEP_MARKER == 0 )); then
        rm -f -- "$DIRTY"
    fi
    lock_drop
    (( rc == 0 )) && return 0 || return 2
}

# Entry point for a *.post that targets board news with sections on.
# Works on a snapshot so a concurrent publisher removing the file is harmless.
process_news_post() { # process_news_post <file>
    local f=$1 snap hdr rc
    snap=$(mktemp "$STATE/tmp/snap.XXXXXX") || return 2
    hdr=$(mktemp "$STATE/tmp/hdr.XXXXXX") || { rm -f "$snap"; return 2; }
    if ! cp -- "$f" "$snap" 2>/dev/null; then
        rm -f "$snap" "$hdr"; return 0   # already handled by another run
    fi
    sed '/^$/q' "$snap" | sed '${/^$/d}' > "$hdr"
    handle_news_post "$snap" "$hdr"
    rc=$?
    rm -f "$snap" "$hdr"
    return $rc
}

# Move a permanently rejected queue file out of the queue.
quarantine() { # quarantine <file>
    mkdir -p -m 0750 "$REJECTED" 2>/dev/null
    if mv -f -- "$1" "$REJECTED/$(basename "$1")" 2>/dev/null; then
        touch -- "$REJECTED/$(basename "$1")"   # retention counts from now
    fi
}

handle_post() { # handle_post <file> <owner account>
    local f=$1 owner=$2 board subject parent msgid stamp out tmp
    board=$(field "$f" Board)
    subject=$(field "$f" Subject | LC_ALL=C.UTF-8 sed 's/[[:cntrl:]]//g' | head -c 100)
    parent=$(field "$f" Parent)

    # Board names come from a fixed pattern and an existing directory, never as a raw path.
    [[ $board =~ ^[a-z0-9_-]{1,32}$ && -d $BBS_ROOT/boards/$board && ! -L $BBS_ROOT/boards/$board ]] || return 1
    [[ -n $subject ]] || return 1
    [[ -z $parent || $parent =~ ^[0-9a-f-]{36}$ ]] || return 1
    # A private board takes posts only from its members.
    if is_private "$board"; then
        in_group "$owner" "bbsb-$board" || return 1
    fi
    # A read-only board (the news board) takes posts only from the news account.
    if [[ -f $META/$board.readonly && $owner != bbs-news ]]; then return 1; fi

    msgid=$(cat /proc/sys/kernel/random/uuid)
    stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    out=$BBS_ROOT/boards/$board/$(date +%s)-$msgid.msg
    tmp=$BBS_ROOT/boards/$board/.tmp.$msgid

    # Body is everything after the first blank line.
    {
        printf 'Msgid: %s\n' "$msgid"
        printf 'Author: %s\n' "${owner#bbs-}"
        printf 'Node: %s\n' "$host"
        printf 'Date: %s\n' "$stamp"
        printf 'Subject: %s\n' "$subject"
        [[ -n $parent ]] && printf 'Parent: %s\n' "$parent"
        printf '\n'
        awk 'found { print } /^$/ && !found { found = 1 }' "$f" | LC_ALL=C.UTF-8 sed 's/[[:cntrl:]]//g'
    } > "$tmp" || return 1
    if is_private "$board"; then
        chgrp "bbsb-$board" "$tmp" && chmod 0640 "$tmp" || return 1
    else
        chmod 0644 "$tmp" || return 1
    fi
    mv -f "$tmp" "$out" || return 1
}

# Value of a header, read from the header block only (up to the first blank line).
hdr_get() { # hdr_get <file> <Name>
    sed '/^$/q' "$1" | sed -n "s/^$2: *//p" | head -n 1
}

# Mode and group for a board post: 0640 with the board group when private, else 0644.
post_mode() { # post_mode <file> <board>
    if is_private "$2"; then
        chgrp "bbsb-$2" "$1" && chmod 0640 "$1"
    else
        chmod 0644 "$1"
    fi
}

# Post file as the publisher writes it: headers in fixed order, body on stdin.
post_out() { # post_out <Msgid> <Author> <Node> <Date> <Subject> <Parent> <Edited> <Deleted>
    printf 'Msgid: %s\n' "$1"
    printf 'Author: %s\n' "$2"
    printf 'Node: %s\n' "$3"
    printf 'Date: %s\n' "$4"
    printf 'Subject: %s\n' "$5"
    if [[ -n $6 ]]; then printf 'Parent: %s\n' "$6"; fi
    if [[ -n $7 ]]; then printf 'Edited: %s\n' "$7"; fi
    if [[ -n $8 ]]; then printf 'Deleted: %s\n' "$8"; fi
    printf '\n'
    cat
}

# The one live file of a post, boards/<board>/<epoch>-<msgid>.msg. Prints it or fails.
post_file() { # post_file <board> <msgid>
    local hits=("$BBS_ROOT/boards/$1"/*-"$2".msg)
    (( ${#hits[@]} == 1 )) || return 1
    [[ -f ${hits[0]} && ! -L ${hits[0]} ]] || return 1
    printf '%s\n' "${hits[0]}"
}

# Keep the current version of a post before it is replaced. Root only:
# state/history is 0700 per level, files 0600.
save_history() { # save_history <file> <board> <msgid> <tid>
    local d=$HISTORY/$2/$3 n h
    install -d -m 0700 "$HISTORY" && install -d -m 0700 "$HISTORY/$2" && install -d -m 0700 "$d" || return 1
    n=$(( $(ls -1 "$d" | wc -l) + 1 ))
    h=$d/$n-$4.msg
    install -m 0600 -- "$1" "$h.tmp" && mv -f -- "$h.tmp" "$h"
}

# Apply edit-post or delete-post to one post. Caller holds the ledger lock.
# Returns 0 done, 1 rejected. The owner is the account that wrote the request.
change_post() { # change_post <action> <request> <owner account> <board> <msgid>
    local action=$1 req=$2 owner=$3 board=$4 msgid=$5 me=${3#bbs-}
    local old author node posted parent stamp tid tmp subj body bk
    old=$(post_file "$board" "$msgid") || return 1
    [[ $(hdr_get "$old" Msgid) == "$msgid" ]] || return 1
    # A deleted post is a stub and cannot change again.
    sed '/^$/q' "$old" | grep -q '^Deleted: ' && return 1
    # A private board takes requests only from its members.
    if is_private "$board"; then in_group "$owner" "bbsb-$board" || return 1; fi

    author=$(hdr_get "$old" Author)
    if [[ $action == edit-post ]]; then
        [[ $author == "$me" ]] || return 1
    else
        [[ $author == "$me" ]] || can_manage "$me" "$board" || return 1
    fi

    node=$(hdr_get "$old" Node)
    posted=$(hdr_get "$old" Date)
    parent=$(hdr_get "$old" Parent)
    stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    tid=$(date +%s)
    tmp=$BBS_ROOT/boards/$board/.tmp.$msgid

    if [[ $action == edit-post ]]; then
        subj=$(hdr_get "$req" Subject | LC_ALL=C.UTF-8 sed 's/[[:cntrl:]]//g' | head -c 100)
        body=$(awk 'found { print } /^$/ && !found { found = 1 }' "$req" | LC_ALL=C.UTF-8 sed 's/[[:cntrl:]]//g')
        [[ -n $subj && -n ${body//[[:space:]]/} ]] || return 1
        (( $(printf '%s' "$body" | wc -c) <= MAX_BODY )) || return 1
        save_history "$old" "$board" "$msgid" "$tid" || return 1
        { printf '%s\n' "$body" | post_out "$msgid" "$author" "$node" "$posted" "$subj" "$parent" "$stamp" ""; } > "$tmp" \
            || { rm -f -- "$tmp"; return 1; }
    else
        # Administrative copy first, then the stub. Retention is 30 days (bbs-history-expire).
        install -d -m 0700 "$ADMIN_BACKUP" || return 1
        bk=$ADMIN_BACKUP/$tid-$board-$msgid.msg
        { printf 'Backup-Of: %s\n' "$msgid"; cat -- "$old"; } > "$bk.tmp" \
            && chmod 0600 "$bk.tmp" && mv -f -- "$bk.tmp" "$bk" \
            || { rm -f -- "$bk.tmp"; return 1; }
        if [[ $author != "$me" ]]; then
            # Moderation is logged before the change; a failed log stops it.
            [[ -e $MOD_LOG ]] || install -m 0600 /dev/null "$MOD_LOG" || return 1
            printf '%s\t%s\t%s\t%s\n' "$stamp" "$me" "$board" "$msgid" >> "$MOD_LOG" || return 1
        fi
        { post_out "$msgid" "$author" "$node" "$posted" "[deleted]" "$parent" "" "$stamp" < /dev/null; } > "$tmp" \
            || { rm -f -- "$tmp"; return 1; }
    fi
    post_mode "$tmp" "$board" || { rm -f -- "$tmp"; return 1; }
    mv -f -- "$tmp" "$old"
}

handle_req() { # handle_req <file> <owner account>
    local f=$1 owner=$2 me action board user msgid rc
    me=${owner#bbs-}
    action=$(hdr_get "$f" Action)
    board=$(hdr_get "$f" Board)
    user=$(hdr_get "$f" User)

    [[ $board =~ ^[a-z0-9][a-z0-9_-]{1,23}$ ]] || return 1
    case $action in
        create-board)
            [[ ! -e $BBS_ROOT/boards/$board && ! -e $META/$board.meta ]] || return 1
            getent group "bbsb-$board" >/dev/null && return 1
            (( $(owned_count "$me") < MAX_OWNED )) || return 1
            create_board "$board" "$me"
            ;;
        invite|remove)
            is_private "$board" || return 1
            can_manage "$me" "$board" || return 1
            [[ $user =~ ^[a-z][a-z0-9]{2,8}$ ]] || return 1
            id "bbs-$user" >/dev/null 2>&1 || return 1
            if [[ $action == invite ]]; then
                gpasswd -a "bbs-$user" "bbsb-$board" >/dev/null || return 1
            else
                # The owner cannot be removed from their own board.
                [[ $user != "$(meta_owner "$board")" ]] || return 1
                gpasswd -d "bbs-$user" "bbsb-$board" >/dev/null || return 1
                # Groups are read at login, so end the removed user's sessions now.
                pkill -TERM -u "bbs-$user" 2>/dev/null || true
            fi
            ;;
        edit-post|delete-post)
            msgid=$(hdr_get "$f" Msgid)
            [[ $msgid =~ $UUID_RE ]] || return 1
            [[ -d $BBS_ROOT/boards/$board && ! -L $BBS_ROOT/boards/$board ]] || return 1
            [[ ! -f $META/$board.readonly ]] || return 1
            # Lock timeout is temporary: the request stays in the queue for a retry.
            lock_take || return 2
            change_post "$action" "$f" "$owner" "$board" "$msgid"; rc=$?
            lock_drop
            return $rc
            ;;
        *) return 1 ;;
    esac
}

# Greeting text: one line, valid UTF-8, no control or invisible format
# characters, at most argv[2] characters. Prints the text, or exits 1.
WALL_CLEAN='
import sys, unicodedata
try:
    text = open(sys.argv[1], "rb").read().decode("utf-8").rstrip("\n")
except UnicodeDecodeError:
    sys.exit(1)
if "\n" in text:
    sys.exit(1)
text = "".join(c for c in text if unicodedata.category(c) not in ("Cc", "Cf", "Zl", "Zp")).strip()
if not text or len(text) > int(sys.argv[2]):
    sys.exit(1)
sys.stdout.write(text)
'

# Keep the newest WALL_KEEP greetings. Names start with the publish time, so the
# glob lists the oldest first. Called under wall.lock.
wall_trim() {
    local LC_ALL=C f n
    local -a files=()
    for f in "$WALL"/*.msg; do
        if [[ -f $f && ! -L $f ]]; then files+=("$f"); fi
    done
    n=$(( ${#files[@]} - WALL_KEEP ))
    (( n > 0 )) || return 0
    for f in "${files[@]:0:n}"; do rm -f -- "$f"; done
}

# Publish one greeting. Returns 0 done, 1 rejected, 2 temporary (retry next run).
handle_wall() { # handle_wall <file> <owner account>
    local f=$1 owner=$2 text msgid stamp ns tmp
    (( $(stat -c %s "$f") <= WALL_MAX_BYTES )) || return 1
    text=$(python3 -I -c "$WALL_CLEAN" "$f" "$WALL_MAX_CHARS") || return 1
    [[ -n $text ]] || return 1

    # The name is taken under the lock, so the order of names is the order of publication.
    wall_lock_take || return 2
    ns=$(date +%s%N)
    msgid=$(cat /proc/sys/kernel/random/uuid)
    stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    mkdir -p -m 0755 "$WALL" 2>/dev/null
    tmp=$WALL/.tmp.$msgid
    {
        printf 'Msgid: %s\n' "$msgid"
        printf 'Author: %s\n' "${owner#bbs-}"
        printf 'Node: %s\n' "$host"
        printf 'Date: %s\n' "$stamp"
        printf '\n%s\n' "$text"
    } > "$tmp" && chmod 0644 "$tmp" && mv -f -- "$tmp" "$WALL/$ns-$msgid.msg" \
        || { rm -f -- "$tmp"; wall_lock_drop; return 2; }
    wall_trim
    wall_lock_drop
    return 0
}

process() { # process <file>; returns 0 done, 1 rejected, 2 temporary
    local f=$1 owner board rc mtime id
    [[ -f $f && ! -L $f ]] || return 0
    owner=$(stat -c %U "$f")
    if [[ -n ${BBS_TEST_OWNER:-} ]]; then
        # Test mode: the given account stands in for bbs-news.
        [[ $owner == "$BBS_TEST_OWNER" ]] && owner=bbs-news
    fi
    [[ $owner =~ ^bbs-[a-z][a-z0-9]{2,8}$ ]] || { rm -f "$f"; return 0; }

    # A greeting for the wall has its own rules and lock.
    if [[ $f == *.wall ]]; then
        handle_wall "$f" "$owner"; rc=$?
        case $rc in
            0) rm -f "$f" ;;
            1) echo "rejected wall greeting: $f" >&2; quarantine "$f" ;;
            *) echo "wall greeting kept for retry: $f" >&2 ;;
        esac
        return $rc
    fi

    # A news section post has its own size rule and a ledger entry on reject.
    if [[ $f == *.post && $owner == bbs-news ]] && news_sections_on; then
        board=$(sed '/^$/q' "$f" | sed -n 's/^Board: *//p' | head -n 1)
        if [[ $board == news ]]; then
            LAST_REASON=""
            process_news_post "$f"; rc=$?
            if (( rc == 2 )); then
                mtime=$(stat -c %Y "$f" 2>/dev/null) || return 0
                if (( $(date +%s) - mtime >= STALE_SECS )); then
                    id=$(sed '/^$/q' "$f" | sed -n 's/^Article-Id: *//p' | head -n 1)
                    news_reject "$id" stale; rc=$?
                    LAST_REASON=stale
                fi
            fi
            case $rc in
                0) rm -f "$f" ;;
                1) echo "rejected news post ($LAST_REASON): $f" >&2; quarantine "$f" ;;
                *) echo "news post kept for retry: $f" >&2 ;;
            esac
            return $rc
        fi
    fi

    [[ $(stat -c %s "$f") -le $MAX_BYTES ]] || { rm -f "$f"; return 0; }

    case $f in
        *.post)
            # A post that carries news section headers but has no marker must not
            # fall through to the flat legacy layout.
            if [[ $(sed '/^$/q' "$f" | sed -n 's/^Board: *//p' | head -n 1) == news ]] \
                && sed '/^$/q' "$f" | grep -qE '^(Category|Article-Id): '; then
                echo "rejected news post (bad-board): $f" >&2
                quarantine "$f"
                return 1
            fi
            handle_post "$f" "$owner" || echo "rejected post: $f" >&2 ;;
        *.req)
            handle_req "$f" "$owner"; rc=$?
            case $rc in
                0) ;;
                1) echo "rejected request: $f" >&2; quarantine "$f"; return 1 ;;
                *) echo "request kept for retry: $f" >&2; return 2 ;;
            esac ;;
    esac
    rm -f "$f"
}

# Sourced by a test: stop here, only the functions are wanted.
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0

# Repair the index if a marker is left (an interrupted publication) or the
# index is missing while articles exist. bbs-news-index takes the lock itself.
repair_index() {
    local tool
    tool=$(dirname "$(readlink -f "$0")")/bbs-news-index
    [[ -x $tool ]] || tool=${BBS_NEWS_INDEX:-bbs-news-index}
    BBS_ROOT=$BBS_ROOT BBS_LOCK_WAIT=$LOCK_WAIT "$tool" repair \
        || echo "bbs-publish: index repair failed" >&2
}

reconcile_sysops
mkdir -p "$STATE/tmp" 2>/dev/null
news_sections_on && repair_index
for f in "$INCOMING"/*.post "$INCOMING"/*.req "$INCOMING"/*.wall; do
    process "$f"
done
if [[ -e $DIRTY ]] && news_sections_on; then
    repair_index
fi
